{
    // 将 clang-format 设为 C++ 文件的默认格式化器
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    // 将 clang-format 设为 C 文件的默认格式化器（如果也写 C）
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[cmake]": {
        "editor.defaultFormatter": "cheshirekow.cmake-format",
        "editor.formatOnSave": true
    },
    // 开启“保存时自动格式化”
    "C_Cpp.clang_format_style": "file",
    "cmakeFormat.exePath": "/usr/bin/cmake-format",
    "cmakeFormat.cwd": "${workspaceFolder}",
    "cmakeFormat.args": [
        "--config-file", "${workspaceFolder}/.cmake-format.yaml"
    ],
    "files.associations": {
        "ide.h": "c",
        "drm_drv.h": "c",
        "drm_simple_kms_helper.h": "c",
        "compare": "c",
        "type_traits": "c",
        "utility": "c",
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "concepts": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "ranges": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "typeinfo": "cpp",
        "iostream": "cpp"
    },
    "cmake.autoDetectSourceDirectory": false,
}